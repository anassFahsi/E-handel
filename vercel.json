{
    "version":2,
    "builds":[
      {
        "src":"frontend/package.json",
        "use":"@vercel/vite"
     },
     {
        "src":"api/server.js",
        "use":"vercel/node"
       }
    ],
    "rewrites":[
        {"source":"/api/(.*)","destination":"api/server.js"},
        {"source":"/(.*)","destination":"frontend/$1"}
    ],
    "functions":{
        "api/server.js":{
            "includeFiles":"backend/uploads/**"
        }
    }

}